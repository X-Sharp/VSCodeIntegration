{
  "name": "xsharp-tools",
  "displayName": "XSharp Tools",
  "description": "Build and Run XSharp Projects from VSCode",
  "version": "0.6.0",
  "icon": "xsharp.png",
  "publisher": "XSharp-BV",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fforay/xsharp-tools.git"
  },
  "license": "MIT",
  "keywords": [
    "xsharp",
    "x#"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:xsharp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xml",
        "extensions": [".xsproj"]
      },
      {
        "id": "xsharp",
        "aliases": [
          "XSharp",
          "xsharp"
        ],
        "extensions": [
          ".prg",
          ".ch",
          ".xs",
          ".xsc",
          ".xsprg",
          ".prgx"
        ]
      }
    ],
    "grammars": [
      {
        "language": "xsharp",
        "scopeName": "source.xsharp",
        "path": "./syntaxes/xsharp.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "xsharp",
        "scopes": {
          "keyword":       ["keyword.control.xsharp", "keyword.declaration.xsharp"],
          "modifier":      ["storage.modifier.xsharp"],
          "type":          ["support.type.xsharp"],
          "class":         ["entity.name.class.xsharp"],
          "interface":     ["entity.name.type.interface.xsharp"],
          "struct":        ["entity.name.type.struct.xsharp"],
          "enum":          ["entity.name.type.enum.xsharp"],
          "enumMember":    ["constant.other.enum.xsharp"],
          "namespace":     ["entity.name.namespace.xsharp"],
          "typeParameter": ["entity.name.type.parameter.xsharp"],
          "function":      ["entity.name.function.xsharp"],
          "method":        ["entity.name.function.method.xsharp"],
          "property":      ["variable.other.property.xsharp"],
          "parameter":     ["variable.parameter.xsharp"],
          "variable":      ["variable.other.xsharp"],
          "macro":         ["keyword.control.directive.xsharp"],
          "operator":      ["keyword.operator.xsharp"],
          "number":        ["constant.numeric.xsharp"],
          "string":        ["string.quoted.double.xsharp", "string.quoted.single.xsharp", "string.quoted.other.xsharp"],
          "comment":       ["comment.line.documentation.xsharp", "comment.line.double-slash.xsharp", "comment.block.xsharp"]
        }
      }
    ],
    "configuration": [
      {
        "title": "XSharp Tools",
        "properties": {
          "xsharp-tools.showErrors": {
            "type": "boolean",
            "default": true,
            "description": "If true, the extension will show errors in the Problems panel."
          },
          "xsharp-tools.showWarnings": {
            "type": "boolean",
            "default": true,
            "description": "If true, the extension will show warnings in the Problems panel."
          },
          "xsharp-tools.groupByFile": {
            "type": "boolean",
            "default": true,
            "description": "Regroup errors by file in the Problems panel."
          }
        }
      },
      {
        "title": "XSharp Language Server — Parser",
        "properties": {
          "xsharp.dialect": {
            "type": "string",
            "default": "Core",
            "enum": ["Core", "VO", "Vulcan", "Harbour", "FoxPro", "XPP", "dBase"],
            "description": "XSharp dialect used when parsing source files."
          },
          "xsharp.includePaths": {
            "type": "string",
            "default": "",
            "description": "Semicolon-separated list of additional directories to search for #include files."
          },
          "xsharp.preprocessorSymbols": {
            "type": "string",
            "default": "",
            "description": "Extra preprocessor symbols to define, separated by semicolons (e.g. DEBUG;MYFLAG)."
          }
        }
      },
      {
        "title": "XSharp Language Server — Formatting",
        "properties": {
          "xsharp.keywordCase": {
            "type": "string",
            "default": "Upper",
            "enum": ["None", "Upper", "Lower", "Title"],
            "enumDescriptions": [
              "No automatic case conversion.",
              "Convert keywords to UPPERCASE (e.g. IF, FUNCTION).",
              "Convert keywords to lowercase (e.g. if, function).",
              "Convert keywords to TitleCase (e.g. If, Function)."
            ],
            "description": "Keyword case applied by the 'Fix all keyword casing' code action and the document formatter."
          },
          "xsharp.trimTrailingWhitespace": {
            "type": "boolean",
            "default": true,
            "description": "Remove trailing whitespace from each line when formatting."
          },
          "xsharp.insertFinalNewline": {
            "type": "boolean",
            "default": false,
            "description": "Ensure the file ends with a newline when formatting."
          }
        }
      },
      {
        "title": "XSharp Language Server — Indentation",
        "properties": {
          "xsharp.indentNamespace": {
            "type": "boolean",
            "default": false,
            "description": "Indent entities declared inside a NAMESPACE block."
          },
          "xsharp.indentEntityContent": {
            "type": "boolean",
            "default": true,
            "description": "Indent multiline members (methods, properties, …) inside a CLASS or STRUCTURE."
          },
          "xsharp.indentFieldContent": {
            "type": "boolean",
            "default": true,
            "description": "Indent single-line fields and properties inside a CLASS or STRUCTURE."
          },
          "xsharp.indentBlockContent": {
            "type": "boolean",
            "default": true,
            "description": "Indent statements inside FUNCTION, METHOD, PROCEDURE, and similar code blocks. Mirrors the 'indentFunctionBody' on-type-formatting behaviour."
          },
          "xsharp.indentCaseLabel": {
            "type": "boolean",
            "default": false,
            "description": "Indent CASE and OTHERWISE labels inside a DO CASE / SWITCH block. When false (default) they align with the opener."
          },
          "xsharp.indentCaseContent": {
            "type": "boolean",
            "default": true,
            "description": "Indent statements inside each CASE / OTHERWISE branch."
          },
          "xsharp.indentMultiLines": {
            "type": "boolean",
            "default": true,
            "description": "Indent continuation lines in multi-line statements (lines ending with a continuation character)."
          },
          "xsharp.indentPreprocessorLines": {
            "type": "boolean",
            "default": false,
            "description": "Indent preprocessor directives (#region, #ifdef, #endif, …) with the surrounding code."
          }
        }
      },
      {
        "title": "XSharp Language Server — Diagnostics",
        "properties": {
          "xsharp.semanticDiagnostics": {
            "type": "boolean",
            "default": false,
            "description": "Enable additional semantic diagnostics (e.g. wrong argument count XS0001, unknown LOCAL type XS0003). Off by default — may produce false positives without full type resolution."
          },
          "xsharp.warnOnUndefinedCalls": {
            "type": "boolean",
            "default": false,
            "description": "When true (and semanticDiagnostics is enabled), flag calls to functions not found in the workspace index or referenced assemblies (XS0002). High false-positive risk for runtime functions."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "xsharp.buildProject",
        "title": "Build XSharp Project"
      },
      {
        "command": "xsharp.clearDiagnostics",
        "title": "Clear XSharp Diagnostics"
      },
      {
        "command": "xsharp.runProject",
        "title": "Run XSharp Project",
        "icon": "$(play)"
      },
      {
        "command": "xsharp.settingsPanel",
        "title": "XSharp Tools Settings"
      },
      {
        "command": "xsharp.configureProject",
        "title": "Configure XSharp Project"
      },
      {
        "command": "xsharp.openFolderOfActiveFile",
        "title": "Open Folder of Active File"
      }
    ],
    "submenus": [
      {
        "id": "xstools.submenu",
        "label": "XSharp Tools"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "xstools.submenu",
          "group": "xs_navigation"
        }
      ],
      "xstools.submenu": [
        {
          "command": "xsharp.buildProject",
          "when": "resourceExtname == .xsproj",
          "group": "xssub_navigation"
        },
        {
          "command": "xsharp.runProject",
          "when": "resourceExtname == .xsproj",
          "group": "xssub_navigation@1"
        },
        {
          "command": "xsharp.clearDiagnostics",
          "when": "resourceExtname == .xsproj",
          "group": "xssub_navigation@2"
        },
        {
          "command": "xsharp.settingsPanel",
          "when": "true",
          "group": "xssub_navigation@3"
        },
        {
          "command": "xsharp.configureProject",
          "when": "true",
          "group": "xssub_navigation@4"
        }
      ],
      "editor/title/run": [
        {
          "command": "xsharp.runProject",
          "when": "resourceLangId == xsharp",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "xsharp.openFolderOfActiveFile",
          "group": "navigation",
          "when": "resourceScheme == 'file'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "xsharp.buildProject",
        "key": "ctrl+shift+b",
        "when": "resourceLangId == xsharp"
      },
      {
        "command": "xsharp.runProject",
        "key": "ctrl+f5",
        "when": "resourceLangId == xsharp"
      }
    ],
    "debuggers": [
      {
        "type": "xsharp",
        "label": "XSharp Runner",
        "languages": [
          "xsharp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {}
          }
        },
        "initialConfigurations": [
          {
            "type": "xsharp",
            "request": "launch",
            "name": "Run XSharp Program"
          }
        ],
        "configurationSnippets": [
          {
            "label": "XSharp: Run Project",
            "description": "Run the current XSharp project",
            "body": {
              "type": "xsharp",
              "request": "launch",
              "name": "Run XSharp Program"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "fast-xml-parser": "^5.3.0",
    "vscode-languageclient": "^9.0.1"
  }
}