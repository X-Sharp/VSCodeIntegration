{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XSharp",
  "scopeName": "source.xsharp",
  "fileTypes": [".prg", ".xs", ".xsc", ".xsprg", ".prgx", ".ch"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#preprocessor" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.xsharp",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.documentation.xsharp",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.xsharp",
          "match": "//.*$"
        },
        {
          "name": "comment.line.double-ampersand.xsharp",
          "match": "&&.*$"
        },
        {
          "name": "comment.line.asterisk.xsharp",
          "match": "^\\s*\\*.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xsharp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.xsharp", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.xsharp",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.xsharp", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.other.xsharp",
          "begin": "\\[",
          "end": "\\]"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xsharp",
          "match": "(?i)\\b(IF|ELSE|ELSEIF|ENDIF|DO|WHILE|ENDDO|FOR|FOREACH|NEXT|RETURN|BREAK|LOOP|EXIT|BEGIN|END|TRY|CATCH|FINALLY|ENDTRY|THROW|SWITCH|CASE|OTHERWISE|ENDCASE|REPEAT|UNTIL|WITH|ENDWITH)\\b"
        },
        {
          "name": "keyword.declaration.xsharp",
          "match": "(?i)\\b(FUNCTION|PROCEDURE|METHOD|CLASS|INTERFACE|STRUCTURE|ENUM|DELEGATE|EVENT|CONSTRUCTOR|DESTRUCTOR|PROPERTY|OPERATOR|NAMESPACE|USING|INHERIT|IMPLEMENTS|ENDFUNC|ENDPROC|ENDCLASS)\\b"
        },
        {
          "name": "storage.modifier.xsharp",
          "match": "(?i)\\b(PUBLIC|PRIVATE|PROTECTED|INTERNAL|STATIC|VIRTUAL|ABSTRACT|SEALED|OVERRIDE|NEW|EXTERN|UNSAFE|ASYNC|AWAIT|PARTIAL|READONLY|CONST|VOLATILE|IMPLICIT|EXPLICIT)\\b"
        },
        {
          "name": "keyword.other.xsharp",
          "match": "(?i)\\b(LOCAL|VAR|FIELD|GLOBAL|DEFINE|DECLARE|ASSIGN|ACCESS|IN|OUT|REF|PARAMS|AS|IS|SELF|SUPER|TYPEOF|SIZEOF|DEFAULT|CHECKED|UNCHECKED)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.xsharp",
          "match": "(?i)\\b(STRING|INT|INT64|UINT64|DWORD|WORD|BYTE|SBYTE|SHORT|FLOAT|REAL4|REAL8|LOGIC|USUAL|OBJECT|ARRAY|DATE|DATETIME|SYMBOL|PSZ|PTR|VOID|LONG|LONGINT|SHORTINT)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.xsharp",
          "match": "\\b([0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?)\\b"
        },
        {
          "name": "constant.numeric.hex.xsharp",
          "match": "\\b0[xXhH][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.language.xsharp",
          "match": "(?i)\\b(TRUE|FALSE|NULL|NULL_ARRAY|NULL_CODEBLOCK|NULL_DATE|NULL_OBJECT|NULL_PSZ|NULL_PTR|NULL_STRING|NULL_SYMBOL|NIL)\\b"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "keyword.control.directive.xsharp",
          "match": "^\\s*(#(define|undef|ifdef|ifndef|else|endif|endregion|include|region|command|translate|xcommand|xtranslate|warning|error|line))\\b",
          "captures": {
            "1": { "name": "keyword.control.directive.xsharp" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.xsharp",
          "match": ":=|\\+=|-=|\\*=|\\/=|%=|&=|\\|=|\\^=|==|!=|<>|<=|>=|<<|>>|&&|\\|\\||->|=>|\\.\\.\\.|[+\\-*/%&|^~!<>=@?]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.xsharp",
          "match": "(?i)(?<=\\b(?:FUNCTION|PROCEDURE|METHOD)\\s+)([a-zA-Z_][a-zA-Z0-9_]*)"
        },
        {
          "name": "entity.name.type.xsharp",
          "match": "(?i)(?<=\\b(?:CLASS|INTERFACE|STRUCTURE|ENUM|DELEGATE)\\s+)([a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    }
  }
}
